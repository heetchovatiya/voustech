# Resend API Key (from https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here

# Recipient email address where contact form submission leads will be sent
CONTACT_INBOX_EMAIL=info@voustech.com

# Sender email address
# Note: In Resend free testing mode without a verified domain, this MUST be onboarding@resend.dev
CONTACT_FROM_EMAIL=onboarding@resend.dev

# PostgreSQL Database URL (Neon / Vercel Postgres / Supabase)
DATABASE_URL="postgresql://user:password@ep-cool-db-123456.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Vercel Blob Read/Write Token (Automatically provided by Vercel when linking Blob store)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_token_here
